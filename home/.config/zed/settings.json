// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "soft_wrap": "editor_width",
  "ui_font_weight": 450.0,
  "buffer_font_weight": 450.0,
  "terminal": {
    "font_family": "Geist Mono",
    "font_weight": 400.0,
    "font_size": 14.0,
  },
  "agent": {
    "threads_sidebar": {
      "auto_open": false,
      "default_width": 0.0,
      "position": "right",
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "disable_ai": true,
  "lsp_document_colors": "inlay",
  "cli_default_open_behavior": "existing_window",
  "proxy": "",
  "project_panel": {
    "dock": "right",
    "starts_open": false,
    "hide_root": true,
    "default_width": 400,
    "sticky_scroll": false,
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "default_width": 400,
    "group_by": "staging",
    "tree_view": true,
    "dock": "right",
    "starts_open": true,
  },
  "icon_theme": "Warm Charmed Icons",
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": {
      "control": false,
      "alt": false,
      "shift": false,
      "platform": false,
      "function": false,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": true,
  },
  "ui_font_size": 14,
  "ui_font_family": "Geist Mono",
  "buffer_font_size": 14.0,
  "buffer_font_family": "Geist Mono",
  "theme": {
    "mode": "system",
    "light": "Github Plus Light",
    "dark": "Aura Soft Dark",
  },
  "theme_overrides": {
    "Aura Soft Dark": {
      "elevated_surface.background": "#37376BFF",
      "element.selected": "#990000",
    },
  },
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
      "formatter": [],
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    // "quick_actions": false
  },
  "gutter": {
    "min_line_number_digits": 0,
    "runnables": false,
  },
  "indent_guides": {
    "enabled": false,
  },
  "buffer_line_height": {
    "custom": 1.7,
  },
  "cursor_blink": false,
  "cursor_shape": "hollow",
  "current_line_highlight": "none",
  "show_whitespaces": "none",
  "experimental.theme_overrides": {
    // "editor.document_highlight.read_background": "#992200",
  },
}
