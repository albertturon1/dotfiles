# skhd config - Left Alt (lalt) only bindings for Aerospace
# Right Alt (ralt) remains free for typing Polish characters
# This file should be linked to ~/.config/skhd/skhdrc

# Basic window operations
lalt - x : aerospace fullscreen
# Layout cycling (borders-toggle refreshes conditional JankyBorders visibility)
lalt - z : aerospace layout floating tiling ; $HOME/.config/aerospace/borders-toggle.sh
lalt - 0x2F : aerospace layout tiles horizontal vertical ; $HOME/.config/aerospace/borders-toggle.sh
lalt - 0x2C : aerospace layout accordion horizontal vertical ; $HOME/.config/aerospace/borders-toggle.sh

# Focus movement
lalt - 0x32 : aerospace focus --wrap-around dfs-next
lalt - h : aerospace focus --wrap-around left
lalt - j : aerospace focus down
lalt - k : aerospace focus up
lalt - l : aerospace focus --wrap-around right

# Focus previous window (reverse of lalt - 0x32)
lalt + shift - 0x32 : aerospace focus --wrap-around dfs-prev

# Move windows
lalt + shift - h : aerospace move left
lalt + shift - j : aerospace move down
lalt + shift - k : aerospace move up
lalt + shift - l : aerospace move right

# Resize
lalt + shift - 0x1b : aerospace resize smart -50
lalt + shift - 0x18 : aerospace resize smart +50

# Workspace switching
# Workspace switching: "go" hides borders first, then switches (see borders-toggle.sh).
# A new workspace needs one line here and an entry in persistent-workspaces in ~/.aerospace.toml.
lalt - q : $HOME/.config/aerospace/borders-toggle.sh go workspace Q
lalt - w : $HOME/.config/aerospace/borders-toggle.sh go workspace W
lalt - e : $HOME/.config/aerospace/borders-toggle.sh go workspace E
lalt - a : $HOME/.config/aerospace/borders-toggle.sh go workspace A
lalt - s : $HOME/.config/aerospace/borders-toggle.sh go workspace S
lalt - d : $HOME/.config/aerospace/borders-toggle.sh go workspace D
lalt - f : $HOME/.config/aerospace/borders-toggle.sh go workspace F
lalt - 1 : $HOME/.config/aerospace/borders-toggle.sh go workspace 1
lalt - 2 : $HOME/.config/aerospace/borders-toggle.sh go workspace 2
lalt - 3 : $HOME/.config/aerospace/borders-toggle.sh go workspace 3

# Move node to workspace
lalt + shift - q : aerospace move-node-to-workspace Q
lalt + shift - w : aerospace move-node-to-workspace W
lalt + shift - e : aerospace move-node-to-workspace E
lalt + shift - a : aerospace move-node-to-workspace A
lalt + shift - s : aerospace move-node-to-workspace S
lalt + shift - d : aerospace move-node-to-workspace D
lalt + shift - f : aerospace move-node-to-workspace F
lalt + shift - 1 : aerospace move-node-to-workspace 1
lalt + shift - 2 : aerospace move-node-to-workspace 2
lalt + shift - 3 : aerospace move-node-to-workspace 3

# Workspace navigation
lalt - tab : $HOME/.config/aerospace/borders-toggle.sh go workspace-back-and-forth

# Service mode activation
lalt + shift - 0x29 : aerospace mode service
